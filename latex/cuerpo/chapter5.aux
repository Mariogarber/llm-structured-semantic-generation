\@writefile{toc}{\contentsline {section}{\numberline {5.1}Línea base zero-shot}{39}{section.5.1}\protected@file@percent }
\newlabel{sec:ch5_baseline}{{5.1}{39}{Línea base zero-shot}{section.5.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5.1}{\ignorespaces Métricas del baseline zero-shot en el split de validación (70 muestras totales; 65 con salida estructurada parseable).}}{40}{table.caption.24}\protected@file@percent }
\newlabel{tab:ch5_baseline_metrics}{{5.1}{40}{Métricas del baseline zero-shot en el split de validación (70 muestras totales; 65 con salida estructurada parseable)}{table.caption.24}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces Estado de las predicciones del baseline zero-shot en el split de validación. De las 70 muestras, 65 producen una salida estructurada parseable, pero solo 20 dan lugar a un YAML válido tras la reconstrucción determinista. El cuello de botella no es el formato de bloque sino la consistencia jerárquica dentro de él.}}{40}{figure.caption.25}\protected@file@percent }
\newlabel{fig:ch5_baseline_states}{{5.1}{40}{Estado de las predicciones del baseline zero-shot en el split de validación. De las 70 muestras, 65 producen una salida estructurada parseable, pero solo 20 dan lugar a un YAML válido tras la reconstrucción determinista. El cuello de botella no es el formato de bloque sino la consistencia jerárquica dentro de él}{figure.caption.25}{}}
\citation{hu2021lora,dettmers2023qlora,wu2025sft}
\@writefile{toc}{\contentsline {section}{\numberline {5.2}\texttt  {serialized\_sft}: ajuste con jerarquía en superficie}{41}{section.5.2}\protected@file@percent }
\newlabel{sec:ch5_sft}{{5.2}{41}{\texttt {serialized\_sft}: ajuste con jerarquía en superficie}{section.5.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5.2}{\ignorespaces Comparativa de métricas entre el baseline zero-shot y \texttt  {serialized\_sft} en el split de validación. $\Delta $ indica la diferencia en puntos porcentuales (métricas de tasa) o en unidades absolutas (\texttt  {level\_mae}).}}{42}{table.caption.26}\protected@file@percent }
\newlabel{tab:ch5_comparison}{{5.2}{42}{Comparativa de métricas entre el baseline zero-shot y \texttt {serialized\_sft} en el split de validación. $\Delta $ indica la diferencia en puntos porcentuales (métricas de tasa) o en unidades absolutas (\texttt {level\_mae})}{table.caption.26}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces Curva de pérdida de entrenamiento del \texttt  {serialized\_sft} (LoRA, 3 épocas, 159 pasos globales, 424 muestras de entrenamiento efectivas (426 nominales, 2 omitidas por OOM)). La pérdida desciende de 1{,}32 en el primer paso a valores inferiores a 0{,}2 al final de la primera época. Las épocas segunda y tercera refinan los casos más complejos, con valores de pérdida entre 0{,}03 y 0{,}09.}}{43}{figure.caption.27}\protected@file@percent }
\newlabel{fig:ch5_training_loss}{{5.2}{43}{Curva de pérdida de entrenamiento del \texttt {serialized\_sft} (LoRA, 3 épocas, 159 pasos globales, 424 muestras de entrenamiento efectivas (426 nominales, 2 omitidas por OOM)). La pérdida desciende de 1{,}32 en el primer paso a valores inferiores a 0{,}2 al final de la primera época. Las épocas segunda y tercera refinan los casos más complejos, con valores de pérdida entre 0{,}03 y 0{,}09}{figure.caption.27}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.3}{\ignorespaces Comparativa de métricas clave entre el baseline zero-shot y el \texttt  {serialized\_sft} en el split de validación. El salto de 31\,\% a 99\,\% en parseo YAML y de 28\,\% a 96\,\% en clave semántica muestra que el SFT resuelve de forma simultánea el problema estructural y el de cobertura semántica. La predicción de nivel exacto mejora de 11\,\% a 76\,\%, confirmando que la serialización implícita de jerarquía es suficiente para aprender indentaciones correctas.}}{43}{figure.caption.28}\protected@file@percent }
\newlabel{fig:ch5_metrics_comparison}{{5.3}{43}{Comparativa de métricas clave entre el baseline zero-shot y el \texttt {serialized\_sft} en el split de validación. El salto de 31\,\% a 99\,\% en parseo YAML y de 28\,\% a 96\,\% en clave semántica muestra que el SFT resuelve de forma simultánea el problema estructural y el de cobertura semántica. La predicción de nivel exacto mejora de 11\,\% a 76\,\%, confirmando que la serialización implícita de jerarquía es suficiente para aprender indentaciones correctas}{figure.caption.28}{}}
