\citation{rafailov2023dpo,xu2024dpoPpo}
\@writefile{lot}{\contentsline {table}{\numberline {5.5}{\ignorespaces Perfil de errores de dominio del \texttt  {serialized\_sft} en el split de validación (70 muestras). Los conteos son acumulados sobre todos los recursos generados; una muestra puede contener varios recursos y contribuir con múltiples instancias del mismo tipo de error.}}{46}{table.caption.31}\protected@file@percent }
\newlabel{tab:ch5_error_profile}{{5.5}{46}{Perfil de errores de dominio del \texttt {serialized\_sft} en el split de validación (70 muestras). Los conteos son acumulados sobre todos los recursos generados; una muestra puede contener varios recursos y contribuir con múltiples instancias del mismo tipo de error}{table.caption.31}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.4}{\ignorespaces Distribución de errores de dominio del \texttt  {serialized\_sft} en el split de validación. Los cuatro antipatrones de seguridad (rojo) acumulan 470 instancias; el resto de errores aparece con valores aislados frente a ese bloque dominante. El perfil refleja que el SFT ha resuelto el problema estructural principal, pero ha heredado patrones inseguros presentes en los datos de entrenamiento.}}{47}{figure.caption.32}\protected@file@percent }
\newlabel{fig:ch5_domain_errors}{{5.4}{47}{Distribución de errores de dominio del \texttt {serialized\_sft} en el split de validación. Los cuatro antipatrones de seguridad (rojo) acumulan 470 instancias; el resto de errores aparece con valores aislados frente a ese bloque dominante. El perfil refleja que el SFT ha resuelto el problema estructural principal, pero ha heredado patrones inseguros presentes en los datos de entrenamiento}{figure.caption.32}{}}
