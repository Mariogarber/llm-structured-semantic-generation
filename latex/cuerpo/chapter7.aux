\@writefile{lof}{\contentsline {figure}{\numberline {7.13}{\ignorespaces Comparación de métricas principales entre el baseline, DPO v1 con \(\beta =0{,}30\), DPO v2 con \(lr=10^{-5}\) y DPO v2 con \(lr=10^{-4}\). El aumento de tasa de aprendizaje reduce la estabilidad estructural y no compensa en las métricas semánticas.}}{83}{figure.caption.67}\protected@file@percent }
\newlabel{fig:ch7_dpo_v2_lr1e4_headline_metrics}{{7.13}{83}{Comparación de métricas principales entre el baseline, DPO v1 con \(\beta =0{,}30\), DPO v2 con \(lr=10^{-5}\) y DPO v2 con \(lr=10^{-4}\). El aumento de tasa de aprendizaje reduce la estabilidad estructural y no compensa en las métricas semánticas}{figure.caption.67}{}}
