\@writefile{toc}{\contentsline {section}{\numberline {7.1}Generación de candidatos para DPO}{67}{section.7.1}\protected@file@percent }
\newlabel{sec:ch7_candidate_generation}{{7.1}{67}{Generación de candidatos para DPO}{section.7.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.1}{\ignorespaces Comparación de estrategias de generación de candidatos para DPO. Los pilotos se ejecutaron sobre subconjuntos distintos, por lo que deben leerse como una exploración metodológica y no como una comparación controlada exacta. La fila \texttt  {C6 hot final} agrega las 426 unidades de prompt usadas en la generación principal.}}{68}{figure.caption.50}\protected@file@percent }
\newlabel{fig:ch7_candidate_strategy_comparison}{{7.1}{68}{Comparación de estrategias de generación de candidatos para DPO. Los pilotos se ejecutaron sobre subconjuntos distintos, por lo que deben leerse como una exploración metodológica y no como una comparación controlada exacta. La fila \texttt {C6 hot final} agrega las 426 unidades de prompt usadas en la generación principal}{figure.caption.50}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.2}{\ignorespaces Efecto de la temperatura en los candidatos generados con la configuración \texttt  {C6 hot}. Las temperaturas bajas conservan mejor la calidad media; las temperaturas altas incrementan el riesgo de candidatos inválidos y reducen la adecuación al prompt.}}{69}{figure.caption.51}\protected@file@percent }
\newlabel{fig:ch7_metrics_by_temperature}{{7.2}{69}{Efecto de la temperatura en los candidatos generados con la configuración \texttt {C6 hot}. Las temperaturas bajas conservan mejor la calidad media; las temperaturas altas incrementan el riesgo de candidatos inválidos y reducen la adecuación al prompt}{figure.caption.51}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.3}{\ignorespaces Temperatura que produce el mejor y el peor candidato por prompt en la generación principal \texttt  {C6 hot}. La distribución muestra que las temperaturas bajas dominan entre los mejores candidatos, mientras que las más altas aportan una parte importante de los peores casos.}}{69}{figure.caption.52}\protected@file@percent }
\newlabel{fig:ch7_best_worst_temperature}{{7.3}{69}{Temperatura que produce el mejor y el peor candidato por prompt en la generación principal \texttt {C6 hot}. La distribución muestra que las temperaturas bajas dominan entre los mejores candidatos, mientras que las más altas aportan una parte importante de los peores casos}{figure.caption.52}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.4}{\ignorespaces Distribución del margen entre el mejor y el peor candidato por prompt. El umbral principal de \(0{,}25\) prioriza pares con una diferencia clara, reduciendo el riesgo de entrenar DPO con preferencias ambiguas.}}{70}{figure.caption.53}\protected@file@percent }
\newlabel{fig:ch7_pair_margin_distribution}{{7.4}{70}{Distribución del margen entre el mejor y el peor candidato por prompt. El umbral principal de \(0{,}25\) prioriza pares con una diferencia clara, reduciendo el riesgo de entrenar DPO con preferencias ambiguas}{figure.caption.53}{}}
