\@writefile{lot}{\contentsline {table}{\numberline {7.2}{\ignorespaces Comparación de validación entre el modelo de partida y DPO con \(\beta =0{,}10\). La columna de \(\beta =0{,}30\) se mantiene como marcador de resultados pendientes, porque la evaluación completa sobre los 70 ejemplos de validación no estaba disponible en el momento de redactar esta sección.}}{74}{table.caption.55}\protected@file@percent }
\newlabel{tab:ch7_dpo_v1_validation}{{7.2}{74}{Comparación de validación entre el modelo de partida y DPO con \(\beta =0{,}10\). La columna de \(\beta =0{,}30\) se mantiene como marcador de resultados pendientes, porque la evaluación completa sobre los 70 ejemplos de validación no estaba disponible en el momento de redactar esta sección}{table.caption.55}{}}
