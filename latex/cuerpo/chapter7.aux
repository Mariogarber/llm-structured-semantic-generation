\@writefile{lot}{\contentsline {table}{\numberline {7.3}{\ignorespaces Comparación entre los datasets de preferencias DPO v1 y DPO v2. DPO v2 conserva menos pares, pero los pares retenidos tienen mayor margen medio y están más orientados a fallos estructurales y de dominio.}}{74}{table.caption.56}\protected@file@percent }
\newlabel{tab:ch7_dpo_v1_v2_dataset_summary}{{7.3}{74}{Comparación entre los datasets de preferencias DPO v1 y DPO v2. DPO v2 conserva menos pares, pero los pares retenidos tienen mayor margen medio y están más orientados a fallos estructurales y de dominio}{table.caption.56}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7.5}{\ignorespaces Restricciones principales del selector DPO v2. El objetivo no es maximizar una sola métrica, sino evitar pares donde la preferencia sea contradictoria con el contrato estructural de la tarea.}}{74}{table.caption.57}\protected@file@percent }
\newlabel{tab:ch7_dpo_v2_guardrails}{{7.5}{74}{Restricciones principales del selector DPO v2. El objetivo no es maximizar una sola métrica, sino evitar pares donde la preferencia sea contradictoria con el contrato estructural de la tarea}{table.caption.57}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.6}{\ignorespaces Composición de tipos de pares en DPO v1 y DPO v2. La segunda iteración reduce el número total de pares, pero desplaza el foco hacia contrastes más específicos de dominio y estructura.}}{75}{figure.caption.58}\protected@file@percent }
\newlabel{fig:ch7_dpo_v1_v2_pair_types}{{7.6}{75}{Composición de tipos de pares en DPO v1 y DPO v2. La segunda iteración reduce el número total de pares, pero desplaza el foco hacia contrastes más específicos de dominio y estructura}{figure.caption.58}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.7}{\ignorespaces Distribución de niveles KDV entre salidas preferidas y rechazadas en DPO v2. Los \textit  {chosen} se concentran en niveles altos, mientras que los \textit  {rejected} contienen una proporción elevada de fallos de dominio severos.}}{76}{figure.caption.59}\protected@file@percent }
\newlabel{fig:ch7_dpo_v2_kdv_levels}{{7.7}{76}{Distribución de niveles KDV entre salidas preferidas y rechazadas en DPO v2. Los \textit {chosen} se concentran en niveles altos, mientras que los \textit {rejected} contienen una proporción elevada de fallos de dominio severos}{figure.caption.59}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.8}{\ignorespaces Diferencia media entre salida preferida y salida rechazada en el dataset DPO v2. Las diferencias positivas indican que el selector conserva pares donde la preferencia está apoyada por varias señales y no por una sola métrica aislada.}}{76}{figure.caption.60}\protected@file@percent }
\newlabel{fig:ch7_dpo_v2_metric_deltas}{{7.8}{76}{Diferencia media entre salida preferida y salida rechazada en el dataset DPO v2. Las diferencias positivas indican que el selector conserva pares donde la preferencia está apoyada por varias señales y no por una sola métrica aislada}{figure.caption.60}{}}
