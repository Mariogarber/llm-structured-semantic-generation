\newlabel{tab:ch7_dpo_v2_lr1e5_validation}{{7.7}{78}{Comparación en validación entre el baseline zero-shot, DPO v1 con \(\beta =0{,}30\) y DPO v2}{table.caption.62}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.10}{\ignorespaces Comparación de métricas principales entre el baseline zero-shot, DPO v1 con \(\beta =0{,}30\) y DPO v2. La figura resume el salto de régimen respecto al modelo base y el refinamiento más pequeño respecto a DPO v1.}}{79}{figure.caption.63}\protected@file@percent }
\newlabel{fig:ch7_dpo_v2_lr1e5_headline_metrics}{{7.10}{79}{Comparación de métricas principales entre el baseline zero-shot, DPO v1 con \(\beta =0{,}30\) y DPO v2. La figura resume el salto de régimen respecto al modelo base y el refinamiento más pequeño respecto a DPO v1}{figure.caption.63}{}}
