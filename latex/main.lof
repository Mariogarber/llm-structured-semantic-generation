\contentsline {figure}{\numberline {3.4}{\ignorespaces Distribución de bloques por nivel de indentación en el conjunto canónico.}}{21}{figure.caption.13}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces Distribuciones de complejidad estructural en el dataset canónico.}}{22}{figure.caption.14}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces Matriz de confusión del \textit {latent probe} para predicción de nivel de indentación.}}{23}{figure.caption.15}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces Cobertura de campos semánticos relevantes en manifiestos Kubernetes del dataset.}}{24}{figure.caption.16}%
